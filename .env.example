# App
NEXT_PUBLIC_APP_URL=

# AI routing
AI_PROVIDER=auto

# Gemini Developer API (only when Gemini is used)
# Use an auth key from Google AI Studio; keep server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium

# Optional Vertex AI path (only if a Google Cloud project is deliberately provisioned)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=false

# Supabase (only if used)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Sandbox (only if monetized)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Resend (only if email is used)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog (only if analytics is used)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry (only if monitoring is used)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
